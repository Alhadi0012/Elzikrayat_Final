# Copy this file to  .env  and fill in the real values.
# server/.env is in .gitignore and must never be committed.

# ---- Database ----
# Local MongoDB. Use 127.0.0.1, not localhost: Node may resolve
# localhost to ::1 and fail to connect even when MongoDB is running.
MONGODB_URI=mongodb://127.0.0.1:27017/alzikrayat

# ---- Server ----
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Cloudinary (phase 4) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email / OTP ----
# Gmail needs an APP PASSWORD (16 characters), not your normal password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
# Leave EMAIL_USER empty during development and the code is printed
# to the terminal instead of being emailed.
# For another provider (e.g. Brevo) set EMAIL_HOST and EMAIL_PORT too.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Alzikrayat <no-reply@alzikrayat.com>
#EMAIL_HOST=
#EMAIL_PORT=587
